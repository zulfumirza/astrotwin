# Copy to .env (never commit .env). All keys stay on the server: the browser
# only ever talks to /api/* on this app.

# NASA API key for DONKI (https://api.nasa.gov). DEMO_KEY works for development
# but is rate-limited (about 30 requests/hour per IP).
NASA_API_KEY="DEMO_KEY"

# Gemini API key (Google AI Studio). Optional: without it the app uses the
# deterministic offline SBAR template and still works fully.
GEMINI_API_KEY=""

# Gemini model used by the narrator. Any current Flash model id works.
GEMINI_MODEL="gemini-flash-latest"
# Used automatically when the model above is overloaded or times out.
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"

# Port for the Express server (Cloud Run sets this automatically).
PORT=3000
